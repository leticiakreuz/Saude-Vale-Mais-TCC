rules_version = '2';
// usuarios/{uid}: dados pessoais e endereço completos são gravados pelas APIs Admin.
// cadastroVersao (2), uid, e-mail e vínculo territorial são imutáveis pelo SDK cliente.
// Somente os quatro campos autodeclarados de gestação abaixo podem ser atualizados pelo dono.
// Subcoleções clínicas são privadas, sem escrita cliente e exigem cadastro validado.
service cloud.firestore {
  match /databases/{database}/documents {
    function dono(uid) { return request.auth != null && request.auth.uid == uid; }
    function texto(d, campo, min, max) { return d.get(campo, null) is string && d[campo].size() >= min && d[campo].size() <= max; }
    function perfilValido(d, uid) {
      return d.get('cadastroVersao', 0) == 2 && d.get('uid', '') == uid
        && texto(d, 'nome', 3, 120) && texto(d, 'email', 3, 160)
        && texto(d, 'cpf', 11, 11) && d.cpf.matches('[0-9]{11}')
        && texto(d, 'telefone', 10, 11) && d.telefone.matches('[0-9]{10,11}')
        && texto(d, 'numeroSUS', 15, 15) && d.numeroSUS.matches('[0-9]{15}')
        && texto(d, 'dataNascimento', 10, 10) && d.dataNascimento.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && texto(d, 'cep', 8, 8) && d.cep.matches('[0-9]{8}')
        && texto(d, 'rua', 1, 160) && texto(d, 'numero', 1, 6) && texto(d, 'bairro', 1, 100)
        && d.get('cidade', '') == 'Blumenau' && d.get('uf', '') == 'SC'
        && texto(d, 'unidadeReferencia', 1, 160);
    }
    function validado(uid) { return perfilValido(get(/databases/$(database)/documents/usuarios/$(uid)).data, uid); }
    function gestacaoValida(d) {
      let semana = d.get('semanasGestacao', null);
      let inicio = d.get('inicioGestacao', null);
      return d.get('gestanteAtual', false) is bool && d.get('jaFoiGestante', false) is bool
        && (semana == null || (semana is int && semana >= 0 && semana <= 43))
        && (inicio == null || (inicio is string && inicio.size() <= 10 && inicio.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }
    match /usuarios/{uid} {
      allow read: if dono(uid);
      allow create: if false;
      allow update: if dono(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gestanteAtual', 'jaFoiGestante', 'semanasGestacao', 'inicioGestacao'])
        && perfilValido(request.resource.data, uid)
        && gestacaoValida(request.resource.data);
      allow delete: if false;
      match /agendamentos/{id} { allow read: if dono(uid) && validado(uid); allow write: if false; }
      match /controleAgendamento/{id} { allow read: if dono(uid) && validado(uid); allow write: if false; }
      match /medicamentos/{id} { allow read: if dono(uid) && validado(uid); allow write: if false; }
      match /vacinacao/{id} { allow read: if dono(uid) && validado(uid); allow write: if false; }
      match /reclamacoes/{id} {
        allow read: if dono(uid);
        allow create: if dono(uid)
          && request.resource.data.keys().hasOnly(['tipo', 'assunto', 'descricao', 'status', 'criadaEm', 'uid'])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'Recebida'
          && request.resource.data.tipo in ['Reclamação', 'Sugestão', 'Elogio', 'Solicitação']
          && request.resource.data.assunto is string && request.resource.data.assunto.size() > 0 && request.resource.data.assunto.size() <= 200
          && request.resource.data.descricao is string && request.resource.data.descricao.size() >= 10 && request.resource.data.descricao.size() <= 5000
          && request.resource.data.criadaEm == request.time;
        allow update, delete: if false;
      }
    }
    match /calendarioVacinacao/{id} { allow read: if request.auth != null; allow write: if false; }
    // Firebase Admin ignora as Rules: cada API valida cargo, permissão, status e UBS no servidor.
    match /profissionais/{id} { allow read, write: if false; }
    match /vinculosAgenda/{id} { allow read, write: if false; }
    match /escalas/{id} { allow read, write: if false; }
    match /servicosAtendimento/{id} { allow read, write: if false; }
    match /horariosReservados/{id} { allow read, write: if false; }
    match /auditoria/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
