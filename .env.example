# Configuração pública do seu aplicativo Web Firebase (Console > Configurações do projeto).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Exclusivas do servidor. Nunca use o prefixo NEXT_PUBLIC nestas variáveis.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Apenas para scripts administrativos locais.
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho-seguro-fora-do-repositorio\service-account.json
